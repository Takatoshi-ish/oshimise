# Database (Coolify Internal connection string)
DATABASE_URL=postgres://postgres:PASSWORD@HOST:5432/postgres

# Google Maps / Places (server-side, restricted to Places API in GCP)
GOOGLE_MAPS_API_KEY=

# Google Maps for browser display (referrer-restricted to https://oshimise.duckdns.org/*)
NEXT_PUBLIC_MAPS_BROWSER_KEY=

# Google Sheets sync
GOOGLE_SHEETS_ID=1HgnHPDua-Syhuhuih-LHqybop4HZ244KMnrwxfg1K5o
GOOGLE_SERVICE_ACCOUNT_JSON=

# Upload directory (mount as persistent volume in Coolify, e.g. /app/uploads)
UPLOAD_DIR=/app/uploads

# Public URL of the app
NEXT_PUBLIC_APP_URL=https://oshimise.duckdns.org

# Admin passcode (use a hard-to-guess string in production)
ADMIN_PASSCODE=oshimise2026
